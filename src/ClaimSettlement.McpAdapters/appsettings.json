{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-mcp-adapters-client-id>",
    "Audience": "api://<your-mcp-adapters-client-id>"
  },
  "ExternalServices": {
    "PolicyManagementApi": {
      "BaseUrl": "https://policy-management-api.example.com",
      "Scope": "api://<policy-api-client-id>/.default"
    },
    "FraudDetectionService": {
      "BaseUrl": "https://fraud-detection-service.example.com",
      "Scope": "api://<fraud-service-client-id>/.default"
    },
    "NotificationService": {
      "BaseUrl": "https://notification-service.example.com",
      "Scope": "api://<notification-service-client-id>/.default"
    },
    "DocumentIntelligence": {
      "Endpoint": "https://<your-region>.cognitiveservices.azure.com/",
      "DeploymentId": "prebuilt-document"
    }
  }
}
